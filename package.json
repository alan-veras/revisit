{
	"name": "revisit",
	"version": "0.6.0",
	"description": "Spaced repetition flashcards with FSRS. Pick your time and review; the deck is chosen when the card is created.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"deploy": "npm run build && node scripts/deploy.mjs",
		"test": "TZ=America/Fortaleza vitest run --reporter=dot --silent=passed-only --exclude tests/stress.test.ts",
		"test:stress": "TZ=America/Fortaleza vitest run --reporter=dot tests/stress.test.ts",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.20.4",
		"esbuild": "^0.25.5",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.12.0",
		"jiti": "^2.7.0",
		"obsidian": "^1.13.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"ts-fsrs": "5.4.2"
	}
}
